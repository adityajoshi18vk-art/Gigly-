# ─── Gigly Contracts — Environment Variables ───────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# Polygon Amoy testnet RPC (get one free from Alchemy or QuickNode)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployer wallet private key (WITHOUT 0x prefix)
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Arbiter address — the wallet that resolves disputes
ARBITER_ADDRESS=0x0000000000000000000000000000000000000000

# Platform fee in basis points (250 = 2.5%, max 300 = 3%)
FEE_BPS=250
